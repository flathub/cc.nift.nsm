          "url": "https://raw.githubusercontent.com/nifty-site-manager/nsm-flatpak/c6cc086986a38278d0957acaaf6a5f301a8db926/cc.nift.nsm64.png",
          "sha256": "8ecee55e62c3472804d4e2510b81989ea62c7661526f11321fcffe62ec8003f2"
