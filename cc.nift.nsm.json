{
    "app-id": "cc.nift.nsm",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "nsm",
    "finish-args": [
        "--filesystem=host",
        "--share=network",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "modules": [
        {
            "name": "git",
            "make-args": [
                "INSTALL_SYMLINKS=1"
            ],
            "make-install-args": [
                "INSTALL_SYMLINKS=1"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://mirrors.edge.kernel.org/pub/software/scm/git/git-2.54.0.tar.xz",
                    "sha256": "f689162364c10de79ef89aa8dbf48731eb057e34edbbd20aca510ce0154681a3",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5350,
                        "stable-only": true,
                        "url-template": "https://mirrors.edge.kernel.org/pub/software/scm/git/git-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "nsm",
            "no-autogen": true,
            "no-parallel-make": true,
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/nifty-site-manager/nsm-flatpak.git",
                    "tag": "v2.4.12",
                    "commit": "c6cc086986a38278d0957acaaf6a5f301a8db926"
                },
                {
                    "type": "patch",
                    "path": "patches/nsm-fixes.patch"
                }
            ]
        },
        {
            "name": "luarocks",
            "no-autogen": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://luarocks.org/releases/luarocks-3.3.0.tar.gz",
                    "sha256": "8de54eb851f5245ed3708d94d8872e825b9704049d3ad4febe8e219f419b427d"
                },
                {
                    "type": "shell",
                    "commands": [
                        "sed -i 's|/usr/local|/app|' ./Makefile"
                    ]
                }
            ]
        }
    ]
}
