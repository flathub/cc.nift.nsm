          "sha256": "23c38f46177315b8f945bd0d0d0d57e5207037de5edc5b5138c1a6bf4d268f55"
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/nifty-site-manager/nsm-flatpak/c6cc086986a38278d0957acaaf6a5f301a8db926/cc.nift.nsm512.png",
          "sha256": "db2efe767407edf1f1820fe6905f12191c4e3a5439324d0af526d64d98c8415a"
        }
      ]
    }
  ]
}
  
