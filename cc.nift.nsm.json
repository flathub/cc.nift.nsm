          "url": "https://raw.githubusercontent.com/nifty-site-manager/nsm-flatpak/c6cc086986a38278d0957acaaf6a5f301a8db926/cc.nift.nsm.desktop",
          "sha256": "23ab22413c3b889d07c4d1825ee411f45ee65ada2e8a2d7885a90b283dc083bc"
        },
        {
