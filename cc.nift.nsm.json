{
  "app-id": "cc.nift.nsm",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "nift",
  "finish-args": [
    "--filesystem=host",
    "--share=network"
  ],
  "modules": [
    {
      "name": "nift",
      "buildsystem": "simple",
      "build-commands": [
        "make -j$FLATPAK_BUILDER_N_JOBS",
        "make install DESTDIR=/app PREFIX=",
        "sed -i 's|<url type=\"bugtracker\">https://github.com/nifty-site-manager/nsm-flatpak/issues</url>|<url type=\"bugtracker\">https://github.com/nift-dev/nift/issues</url><url type=\"vcs-browser\">https://github.com/nift-dev/nift</url>|' cc.nift.nsm.appdata.xml",
        "sed -i 's|<summary>.*</summary>|<summary>Fast dependency-aware website generator</summary>|' cc.nift.nsm.appdata.xml",
        "sed -i 's|Nift (aka nsm) is a cross-platform open source CLI website generator.|Nift is a production-grade, dependency-aware website generator with fast incremental builds, structured data validation and framework-agnostic output.|' cc.nift.nsm.appdata.xml",
        "sed -i '/nift.dev\\/support.html/d; s|<developer_name>Nick Ham</developer_name>|<developer id=\"dev.nift\"><name>Nick Ham</name></developer>|' cc.nift.nsm.appdata.xml",
        "sed -i 's|<icon height=\"128\" width=\"128\">$APPID.png</icon>|<icon type=\"stock\">cc.nift.nsm</icon>|; /<icon height=\"64\"/d' cc.nift.nsm.appdata.xml",
        "sed -i 's|<launchable|<provides><binary>nift</binary></provides><launchable|' cc.nift.nsm.appdata.xml",
        "sed -i 's|<releases>|<releases><release version=\"4.0.3\" date=\"2026-08-20\" /><release version=\"4.0.1\" date=\"2026-08-17\" />|' cc.nift.nsm.appdata.xml",
        "sed -i '/^Version=/d; s/^Exec=nsm$/Exec=nift/; s/^Categories=.*/Categories=ConsoleOnly;Development;Office;Utility;/; /Name.en_AU./d' cc.nift.nsm.desktop",
        "install -Dm644 cc.nift.nsm.appdata.xml /app/share/metainfo/cc.nift.nsm.metainfo.xml",
        "install -Dm644 cc.nift.nsm.desktop /app/share/applications/cc.nift.nsm.desktop",
        "install -Dm644 cc.nift.nsm64.png /app/share/icons/hicolor/64x64/apps/cc.nift.nsm.png",
        "install -Dm644 cc.nift.nsm128.png /app/share/icons/hicolor/128x128/apps/cc.nift.nsm.png",
        "install -Dm644 cc.nift.nsm256.png /app/share/icons/hicolor/256x256/apps/cc.nift.nsm.png",
        "install -Dm644 cc.nift.nsm512.png /app/share/icons/hicolor/512x512/apps/cc.nift.nsm.png"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/nift-dev/nift/archive/refs/tags/v4.0.3.tar.gz",
          "sha256": "63fb05f737c3d1cb83f80663ffd5394821125a5db5d004ffe19d33ecdb2a3a52",
          "x-checker-data": {
            "type": "json",
            "url": "https://api.github.com/repos/nift-dev/nift/releases/latest",
            "version-query": ".tag_name | sub(\"^v\"; \"\")",
            "url-template": "https://github.com/nift-dev/nift/archive/refs/tags/v$version.tar.gz"
          }
        },
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/nifty-site-manager/nsm-flatpak/c6cc086986a38278d0957acaaf6a5f301a8db926/cc.nift.nsm.appdata.xml",
          "sha256": "af7fb02d7322a575880ba3679943036948cc05b360f07cb98e53013bb7aa4e65"
        },
        {
